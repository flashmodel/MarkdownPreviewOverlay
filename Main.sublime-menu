[
    {
        "caption": "Preferences",
        "mnemonic": "n",
        "id": "preferences",
        "children": [
            {
                "caption": "Package Settings",
                "mnemonic": "P",
                "id": "package-settings",
                "children": [
                    {
                        "caption": "MarkdownPreviewOverlay",
                        "children": [
                            {
                                "caption": "Settings",
                                "command": "edit_settings",
                                "args": {
                                    "base_file": "${packages}/MarkdownPreviewOverlay/MarkdownPreviewOverlay.sublime-settings",
                                    "default": "{\n\t\"show_preview_button\": true\n}\n"
                                }
                            },
                            {
                                "caption": "-"
                            },
                            {
                                "caption": "Key Bindings",
                                "command": "edit_settings",
                                "args": {
                                    "base_file": "${packages}/MarkdownPreviewOverlay/Default (${platform}).sublime-keymap.example",
                                    "user_file": "${packages}/User/Default (${platform}).sublime-keymap",
                                    "default": "[\n\t{\n\t\t\"keys\": [\"super+alt+m\"],\n\t\t\"command\": \"markdown_preview_overlay_toggle\",\n\t\t\"context\": [\n\t\t\t{\n\t\t\t\t\"key\": \"selector\",\n\t\t\t\t\"operator\": \"equal\",\n\t\t\t\t\"operand\": \"text.html.markdown\"\n\t\t\t}\n\t\t]\n\t}\n]\n"
                                }
                            }
                        ]
                    }
                ]
            }
        ]
    }
]
